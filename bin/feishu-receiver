#!/usr/bin/env bash
set -euo pipefail

# 飞书消息接收服务主控脚本
# 用法: feishu-receiver {start|stop|status|restart|foreground|setup|help}

# 解析路径
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
LIB_DIR="$BASE_DIR/lib"
CONFIG_FILE="$BASE_DIR/config.json"
PID_FILE="$BASE_DIR/feishu-receiver.pid"

# 自动检测 Python
detect_python() {
    for py in python3 python; do
        if command -v "$py" &>/dev/null && "$py" -c "print('ok')" 2>/dev/null | grep -q ok; then
            echo "$py"
            return
        fi
    done
    echo "python3"
}
PYTHON="$(detect_python)"

# 加载配置
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        WORK_DIR=$($PYTHON -c "import json; print(json.load(open('$CONFIG_FILE')).get('workdir', '$HOME/workspace'))")
        BOT_NAME=$($PYTHON -c "import json; print(json.load(open('$CONFIG_FILE')).get('feishu', {}).get('bot_name', '我的飞书机器人'))")
    else
        WORK_DIR="${HOME}/workspace"
        BOT_NAME="我的飞书机器人"
    fi
}

cmd_help() {
    cat <<EOF
飞书消息接收服务 - 主控脚本

用法: $(basename "$0") <命令>

命令:
  start       后台启动服务
  stop        停止服务
  status      查看服务状态
  restart     重启服务
  foreground  前台运行（Ctrl+C 停止）
  setup       交互式配置向导
  uninstall   卸载服务
  help        显示此帮助信息

配置: $CONFIG_FILE
EOF
}

cmd_setup() {
    echo "========================================"
    echo "  飞书消息接收服务 - 配置向导"
    echo "========================================"
    echo ""

    # 检查依赖
    echo "==> 检查依赖..."
    local missing=()
    for cmd in python3 lark-cli; do
        if ! command -v "$cmd" &>/dev/null; then
            echo "  错误: $cmd 未找到" >&2
            missing+=("$cmd")
        fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "请先安装: ${missing[*]}" >&2
        exit 1
    fi
    echo "  依赖检查通过"
    echo ""

    # 配置飞书应用
    echo "==> 飞书应用配置"
    echo "  需要从飞书开放平台获取 App ID 和 App Secret"
    echo "  申请地址: https://open.feishu.cn/app"
    echo ""

    local app_id app_secret
    read -rp "  请输入 App ID: " app_id
    read -rsp "  请输入 App Secret (输入不会显示): " app_secret
    echo ""

    # 配置 lark-cli
    if [[ -n "$app_id" && -n "$app_secret" ]]; then
        echo "$app_secret" | lark-cli config init --app-id "$app_id" --app-secret-stdin --brand feishu
        echo "  lark-cli 配置完成"
    fi
    echo ""

    # 配置 AI 工具
    echo "==> AI 工具配置"
    echo "  可选: claude, codex, opencode"
    local ai_tool="claude"
    read -rp "  默认 AI 工具 (默认: claude): " input_tool
    if [[ -n "$input_tool" ]]; then
        ai_tool="$input_tool"
    fi

    # 检查工具是否可用
    if ! command -v "$ai_tool" &>/dev/null; then
        echo "  警告: $ai_tool 未找到，请确保已安装" >&2
    fi

    local ai_timeout=300
    read -rp "  超时秒数 (默认: 300): " input_timeout
    if [[ -n "$input_timeout" ]]; then
        ai_timeout="$input_timeout"
    fi
    echo ""

    # 工作目录
    echo "==> 工作目录配置"
    local work_dir="${HOME}/workspace"
    read -rp "  工作目录 (默认: $work_dir): " input_workdir
    if [[ -n "$input_workdir" ]]; then
        work_dir="$input_workdir"
    fi
    echo ""

    # 会话配置
    echo "==> 会话配置"
    local session_enabled="true"
    read -rp "  启用会话模式? (Y/n): " input_session
    if [[ "$input_session" =~ ^[Nn] ]]; then
        session_enabled="false"
    fi

    local max_history=50
    read -rp "  最大会话历史条数 (默认: 50): " input_history
    if [[ -n "$input_history" ]]; then
        max_history="$input_history"
    fi
    echo ""

    # 日志配置
    echo "==> 日志配置"
    local log_level="INFO"
    echo "  可选: DEBUG, INFO, WARNING, ERROR"
    read -rp "  日志级别 (默认: INFO): " input_level
    if [[ -n "$input_level" ]]; then
        log_level="$input_level"
    fi
    echo ""

    # 写入配置文件
    mkdir -p "$BASE_DIR"
    cat > "$CONFIG_FILE" <<EOF
{
  "feishu": {
    "app_id": "$app_id",
    "app_secret": "$app_secret",
    "bot_name": "我的飞书机器人"
  },
  "ai_tool": {
    "default": "$ai_tool",
    "timeout": $ai_timeout
  },
  "session": {
    "enabled": $session_enabled,
    "max_history": $max_history,
    "timeout": 3600
  },
  "workdir": "$work_dir",
  "logging": {
    "level": "$log_level",
    "file": "logs/feishu-receiver.log",
    "max_size_mb": 10,
    "backup_count": 5
  }
}
EOF
    echo "==> 配置已保存到: $CONFIG_FILE"
    echo ""

    # 验证
    echo "==> 验证配置..."
    echo "  工作目录 : $work_dir"
    echo "  AI 工具  : $ai_tool"
    echo "  会话模式 : $session_enabled"
    echo "  日志级别 : $log_level"
    echo ""

    # 飞书权限提醒
    echo "========================================"
    echo "配置完成！请确认以下飞书应用权限已开通:"
    echo "  - im:message                   (发送消息)"
    echo "  - im:message.p2p_msg:readonly  (读取私聊消息)"
    echo ""
    echo "启动服务: $(basename "$0") start"
    echo "========================================"
}

cmd_start() {
    load_config

    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "服务已在运行中 (PID: $pid)"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    echo "==> 启动飞书消息接收服务..."
    mkdir -p "$BASE_DIR/logs"
    nohup $PYTHON "$LIB_DIR/feishu-receiver.py" >> "$BASE_DIR/logs/feishu-receiver.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    sleep 1

    if kill -0 "$pid" 2>/dev/null; then
        echo "服务已启动 (PID: $pid)"
        echo "日志: tail -f $BASE_DIR/logs/feishu-receiver.log"
    else
        echo "服务启动失败，请查看日志"
        rm -f "$PID_FILE"
        exit 1
    fi
}

cmd_stop() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "服务未运行 (找不到 PID 文件)"
        exit 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "服务未运行 (PID: $pid 已不存在)"
        rm -f "$PID_FILE"
        exit 0
    fi

    echo "==> 停止飞书消息接收服务 (PID: $pid)..."
    kill "$pid"
    local count=0
    while kill -0 "$pid" 2>/dev/null && [[ $count -lt 10 ]]; do
        sleep 1
        count=$((count + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "强制终止..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    echo "服务已停止"
}

cmd_status() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "状态: 未运行"
        exit 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
        echo "状态: 运行中 (PID: $pid)"
    else
        echo "状态: 未运行 (PID 文件残留: $pid)"
    fi
}

cmd_restart() {
    cmd_stop || true
    sleep 1
    cmd_start
}

cmd_foreground() {
    load_config
    echo "==> 前台启动飞书消息接收服务 (按 Ctrl+C 停止)..."
    cd "$WORK_DIR" || { echo "错误: 无法进入工作目录 $WORK_DIR" >&2; exit 1; }
    exec $PYTHON "$LIB_DIR/feishu-receiver.py"
}

cmd_uninstall() {
    echo "==> 卸载飞书消息接收服务..."

    # 停止服务
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            echo "==> 停止运行中的服务..."
            kill "$pid" 2>/dev/null || true
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi

    # 停止 systemd 服务
    if [[ -d "${HOME}/.config/systemd/user" ]]; then
        systemctl --user stop feishu-receiver.service 2>/dev/null || true
        systemctl --user disable feishu-receiver.service 2>/dev/null || true
        rm -f "${HOME}/.config/systemd/user/feishu-receiver.service"
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # 删除命令快捷方式
    echo "==> 删除命令快捷方式..."
    rm -f "${HOME}/.local/bin/feishu-receiver"

    # 删除可安全删除的内容
    echo "==> 清理文件..."
    rm -rf "$BASE_DIR/lib" "$BASE_DIR/logs" "$BASE_DIR/bin" "$PID_FILE" 2>/dev/null || true

    echo ""
    echo "卸载完成！"
    echo "配置文件保留在: $CONFIG_FILE"
}

main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 1
    fi

    case "$1" in
        start)      cmd_start ;;
        stop)       cmd_stop ;;
        status)     cmd_status ;;
        restart)    cmd_restart ;;
        foreground) cmd_foreground ;;
        setup)      cmd_setup ;;
        uninstall)  cmd_uninstall ;;
        help|-h|--help) cmd_help ;;
        *)
            echo "未知命令: $1"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
