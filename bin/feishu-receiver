#!/usr/bin/env bash
set -euo pipefail

# 飞书消息接收服务主控脚本
# 用法: feishu-receiver {start|stop|status|restart|foreground|help}

# 解析 symlink 的真实路径，确保通过快捷方式调用时路径正确
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
LIB_DIR="$BASE_DIR/lib"
LOGS_DIR="$BASE_DIR/logs"
PID_FILE="$BASE_DIR/feishu-receiver.pid"

WORK_DIR="${FEISHU_RECEIVER_WORKDIR:-/home/user/workspace}"

cmd_help() {
    cat <<EOF
飞书消息接收服务 - 主控脚本

用法: $(basename "$0") <命令>

命令:
  start       后台启动服务
  stop        停止服务
  status      查看服务状态
  restart     重启服务
  foreground  前台运行（Ctrl+C 停止）
  help        显示此帮助信息

环境变量:
  FEISHU_RECEIVER_WORKDIR        - Claude Code 工作目录 (默认: /home/user/workspace)
  FEISHU_RECEIVER_BOT_NAME       - 机器人名称 (默认: 我的飞书机器人)
  FEISHU_RECEIVER_CLAUDE_TIMEOUT - Claude Code 超时时间 (默认: 300秒)

日志目录: $LOGS_DIR
EOF
}

cmd_start() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "服务已在运行中 (PID: $pid)"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    echo "==> 启动飞书消息接收服务..."
    mkdir -p "$LOGS_DIR"
    nohup python3 "$LIB_DIR/feishu-receiver.py" >> "$LOGS_DIR/feishu-receiver.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    sleep 1

    if kill -0 "$pid" 2>/dev/null; then
        echo "服务已启动 (PID: $pid)"
        echo "日志: tail -f $LOGS_DIR/feishu-receiver.log"
    else
        echo "服务启动失败，请查看日志"
        rm -f "$PID_FILE"
        exit 1
    fi
}

cmd_stop() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "服务未运行 (找不到 PID 文件)"
        exit 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "服务未运行 (PID: $pid 已不存在)"
        rm -f "$PID_FILE"
        exit 0
    fi

    echo "==> 停止飞书消息接收服务 (PID: $pid)..."
    kill "$pid"
    local count=0
    while kill -0 "$pid" 2>/dev/null && [[ $count -lt 10 ]]; do
        sleep 1
        count=$((count + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "强制终止..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    echo "服务已停止"
}

cmd_status() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "状态: 未运行"
        exit 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
        echo "状态: 运行中 (PID: $pid)"
        echo "日志: $LOGS_DIR/feishu-receiver.log"
    else
        echo "状态: 未运行 (PID 文件残留: $pid)"
    fi
}

cmd_restart() {
    cmd_stop || true
    sleep 1
    cmd_start
}

cmd_foreground() {
    echo "==> 前台启动飞书消息接收服务 (按 Ctrl+C 停止)..."
    cd "$WORK_DIR"
    exec python3 "$LIB_DIR/feishu-receiver.py"
}

main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 1
    fi

    case "$1" in
        start)
            cmd_start
            ;;
        stop)
            cmd_stop
            ;;
        status)
            cmd_status
            ;;
        restart)
            cmd_restart
            ;;
        foreground)
            cmd_foreground
            ;;
        help|-h|--help)
            cmd_help
            ;;
        *)
            echo "未知命令: $1"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
