#!/usr/bin/env bash
set -euo pipefail

# 飞书消息接收服务主控脚本
# 用法: feishu-receiver {start|stop|status|restart|foreground|setup|help}

# 解析 symlink 的真实路径，确保通过快捷方式调用时路径正确
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
LIB_DIR="$BASE_DIR/lib"
LOGS_DIR="$BASE_DIR/logs"
PID_FILE="$BASE_DIR/feishu-receiver.pid"
CONFIG_FILE="$BASE_DIR/config"

# 加载配置文件（环境变量优先级更高，不覆盖已设置的值）
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS='=' read -r key value; do
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | xargs | sed 's/^["'"'"']//;s/["'"'"']$//')
            if [[ -n "$key" && ! "$key" =~ ^# ]]; then
                export "${key}=${value}"
            fi
        done < "$CONFIG_FILE"
    fi
}
load_config

# 默认值（环境变量优先于配置文件）
WORK_DIR="${FEISHU_RECEIVER_WORKDIR:-/home/user/workspace}"
BOT_NAME="${FEISHU_RECEIVER_BOT_NAME:-我的飞书机器人}"
CLAUDE_TIMEOUT="${FEISHU_RECEIVER_CLAUDE_TIMEOUT:-300}"

# 自动检测可用的 Python 命令（Windows 上 python3 可能是 Store 占位符）
detect_python() {
    for py in python3 python; do
        if command -v "$py" &>/dev/null && "$py" -c "print('ok')" 2>/dev/null | grep -q ok; then
            echo "$py"
            return
        fi
    done
    # 回退到 python3（如果都不可用，让后续步骤报错）
    echo "python3"
}
PYTHON="$(detect_python)"

cmd_help() {
    cat <<EOF
飞书消息接收服务 - 主控脚本

用法: $(basename "$0") <命令>

命令:
  start       后台启动服务
  stop        停止服务
  status      查看服务状态
  restart     重启服务
  foreground  前台运行（Ctrl+C 停止）
  setup       交互式配置向导
  uninstall   卸载服务
  help        显示此帮助信息

配置: $CONFIG_FILE
日志: $LOGS_DIR
EOF
}

cmd_setup() {
    echo "========================================"
    echo "  飞书消息接收服务 - 配置向导"
    echo "========================================"
    echo ""

    # 检查依赖
    echo "==> 检查依赖..."
    local missing=()
    for cmd in python3 lark-cli claude; do
        if ! command -v "$cmd" &>/dev/null; then
            echo "  错误: $cmd 未找到" >&2
            missing+=("$cmd")
        fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "请先安装: ${missing[*]}" >&2
        exit 1
    fi
    echo "  依赖检查通过"
    echo ""

    # 配置 lark-cli
    echo "==> 飞书应用配置"
    echo "  需要从飞书开放平台获取 App ID 和 App Secret"
    echo "  申请地址: https://open.feishu.cn/app"
    echo ""

    local lark_status
    lark_status=$(lark-cli auth status 2>&1 || true)
    if echo "$lark_status" | grep -q "not configured"; then
        read -rp "  请输入 App ID: " app_id
        read -rsp "  请输入 App Secret (输入不会显示): " app_secret
        echo ""
        if [[ -n "$app_id" && -n "$app_secret" ]]; then
            echo "$app_secret" | lark-cli config init --app-id "$app_id" --app-secret-stdin --brand feishu
            echo "  lark-cli 配置完成"
        else
            echo "  已跳过 lark-cli 配置（需在安装后手动配置）"
        fi
    else
        echo "  lark-cli 已配置，跳过"
    fi
    echo ""

    # 工作目录
    echo "==> 工作目录配置"
    echo "  Claude Code 将在该目录下执行（建议用项目目录）"
    read -rp "  工作目录 (默认: $WORK_DIR): " input_workdir
    if [[ -n "$input_workdir" ]]; then
        WORK_DIR="$input_workdir"
    fi
    echo ""

    # 机器人名称
    echo "==> 机器人名称"
    echo "  即飞书应用中设置的机器人名称，用于过滤消息中的 @提及"
    read -rp "  机器人名称 (默认: $BOT_NAME): " input_botname
    if [[ -n "$input_botname" ]]; then
        BOT_NAME="$input_botname"
    fi
    echo ""

    # 超时时间
    echo "==> Claude Code 超时"
    read -rp "  超时秒数 (默认: $CLAUDE_TIMEOUT): " input_timeout
    if [[ -n "$input_timeout" ]]; then
        CLAUDE_TIMEOUT="$input_timeout"
    fi
    echo ""

    # 写入配置文件
    mkdir -p "$BASE_DIR"
    cat > "$CONFIG_FILE" <<EOF
# 飞书消息接收服务配置文件
# 生成时间: $(date)
# 可通过环境变量覆盖以下配置

FEISHU_RECEIVER_WORKDIR=$WORK_DIR
FEISHU_RECEIVER_BOT_NAME=$BOT_NAME
FEISHU_RECEIVER_CLAUDE_TIMEOUT=$CLAUDE_TIMEOUT
EOF
    echo "==> 配置已保存到: $CONFIG_FILE"
    echo ""

    # 验证
    echo "==> 验证配置..."
    echo "  工作目录 : $WORK_DIR"
    echo "  机器人名 : $BOT_NAME"
    echo "  超时时间 : ${CLAUDE_TIMEOUT}s"
    echo ""

    # 飞书权限提醒
    echo "========================================"
    echo "配置完成！请确认以下飞书应用权限已开通:"
    echo "  - im:message                   (发送消息)"
    echo "  - im:message.p2p_msg:readonly  (读取私聊消息)"
    echo ""
    echo "然后在飞书搜索 '$BOT_NAME' 发起私聊即可。"
    echo ""
    echo "启动服务: $(basename "$0") start"
    echo "========================================"
}

cmd_start() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "服务已在运行中 (PID: $pid)"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    echo "==> 启动飞书消息接收服务..."
    mkdir -p "$LOGS_DIR"
    nohup $PYTHON "$LIB_DIR/feishu-receiver.py" >> "$LOGS_DIR/feishu-receiver.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    sleep 1

    if kill -0 "$pid" 2>/dev/null; then
        echo "服务已启动 (PID: $pid)"
        echo "日志: tail -f $LOGS_DIR/feishu-receiver.log"
    else
        echo "服务启动失败，请查看日志"
        rm -f "$PID_FILE"
        exit 1
    fi
}

cmd_stop() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "服务未运行 (找不到 PID 文件)"
        exit 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "服务未运行 (PID: $pid 已不存在)"
        rm -f "$PID_FILE"
        exit 0
    fi

    echo "==> 停止飞书消息接收服务 (PID: $pid)..."
    kill "$pid"
    local count=0
    while kill -0 "$pid" 2>/dev/null && [[ $count -lt 10 ]]; do
        sleep 1
        count=$((count + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "强制终止..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    echo "服务已停止"
}

cmd_status() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "状态: 未运行"
        exit 0
    fi

    local pid
    pid=$(cat "$PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
        echo "状态: 运行中 (PID: $pid)"
        echo "日志: $LOGS_DIR/feishu-receiver.log"
    else
        echo "状态: 未运行 (PID 文件残留: $pid)"
    fi
}

cmd_restart() {
    cmd_stop || true
    sleep 1
    cmd_start
}

cmd_foreground() {
    echo "==> 前台启动飞书消息接收服务 (按 Ctrl+C 停止)..."
    cd "$WORK_DIR" || { echo "错误: 无法进入工作目录 $WORK_DIR" >&2; exit 1; }
    exec $PYTHON "$LIB_DIR/feishu-receiver.py"
}

cmd_uninstall() {
    echo "==> 卸载飞书消息接收服务..."

    # 停止服务
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            echo "==> 停止运行中的服务..."
            kill "$pid" 2>/dev/null || true
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi

    # 停止 systemd 服务
    if [[ -d "${HOME}/.config/systemd/user" ]]; then
        systemctl --user stop feishu-receiver.service 2>/dev/null || true
        systemctl --user disable feishu-receiver.service 2>/dev/null || true
        rm -f "${HOME}/.config/systemd/user/feishu-receiver.service"
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # 删除命令快捷方式
    echo "==> 删除命令快捷方式..."
    rm -f "${HOME}/.local/bin/feishu-receiver"

    # 删除可安全删除的内容（排除自身所在目录，由调用方清理）
    echo "==> 清理文件..."
    rm -rf "$LIB_DIR" "$LOGS_DIR" "$PID_FILE" "$CONFIG_FILE" 2>/dev/null || true

    echo ""
    echo "卸载完成！"
}

main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 1
    fi

    case "$1" in
        start)      cmd_start ;;
        stop)       cmd_stop ;;
        status)     cmd_status ;;
        restart)    cmd_restart ;;
        foreground) cmd_foreground ;;
        setup)      cmd_setup ;;
        uninstall)  cmd_uninstall ;;
        help|-h|--help) cmd_help ;;
        *)
            echo "未知命令: $1"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
